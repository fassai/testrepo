# --- Engine keys (both optional: app degrades gracefully without them) ---
# Apify — scrapes IG/TikTok profiles. Without it: "limited data" mode.
APIFY_TOKEN=

# Anthropic — LLM scoring layer. Without it: deterministic heuristic scores.
ANTHROPIC_API_KEY=

# Fast/cheap model for scoring (this tool is free + could get abused).
SCORING_MODEL=claude-haiku-4-5

# --- Cost / abuse controls ---
RATE_LIMIT_PER_IP_PER_DAY=5
CACHE_TTL_HOURS=24
SCRAPE_TIMEOUT_SECONDS=90

# --- Conversion ---
# Where the soft CTA sends people (LINE OA of Content Clinic)
CTA_URL=https://lin.ee/REPLACE_ME

# --- Storage ---
DB_PATH=./health_check.db
